<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP by default for apps targeting recent API levels.
  This allows it ONLY for the local dev backend — the emulator's host alias,
  the adb-reverse loopback, and the dev machine's LAN IP — so a real device
  can talk to `php artisan serve` over plain HTTP during development without
  weakening the cleartext restriction for any other host (production stays
  on https:// and needs no exception here at all).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.102</domain>
    </domain-config>
</network-security-config>
